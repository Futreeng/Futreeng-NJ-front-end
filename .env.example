# NJ State Council Hub - Environment Variables

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Anthropic API (Phase 4, feature flag)
ANTHROPIC_API_KEY=sk-ant-...
FEATURE_AI_DRAFTS=false

# Email Provider (Phase 3, feature flag)
RESEND_API_KEY=re_...
FEATURE_EMAIL_ALERTS=false

# SMS Provider (Phase 5, feature flag)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1234567890
FEATURE_SMS_ALERTS=false

# Bot Protection
TURNSTILE_SECRET_KEY=...

# Rate Limiting
RATE_LIMIT_REDIS_URL=redis://...
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_MIN=15

# Monitoring
SENTRY_DSN=https://...@sentry.io/...
NEXT_PUBLIC_SENTRY_ENABLED=true

# Feature Flags
FEATURE_SOURCE_CHECKS=false

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://localhost:3000
REVALIDATE_SECRET=your-secret-here

# Notes:
# - SUPABASE_SERVICE_ROLE_KEY is server-side only. Never expose in client bundles.
# - Feature flags default to false. Enable only when feature is active.
# - All keys are placeholders. Replace with actual values from service providers.
# - Generate REVALIDATE_SECRET with: openssl rand -base64 32
